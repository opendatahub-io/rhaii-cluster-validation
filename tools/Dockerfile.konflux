# CUDA base image (UBI9-based, includes CUDA devel + runtime, sha-pinned)
# All component versions pinned to match AWS EFA installer 1.46.0 / llm-d v0.8.1
ARG AIPCC_BASE_IMAGE=registry.redhat.io/rhai/base-image-cuda13.0-torch2.13-rhel9:1793124388@sha256:8e457469fa7dad4a2b5d7c2b39f0d0409855dd7d881c07ca51f1170b5f04dfca
FROM ${AIPCC_BASE_IMAGE} AS builder

# Needed with aipcc image
USER root

# switch from internal mirrors to public vendor repos
RUN ${APP_ROOT}/lib/tools/public-repos.sh

# Install build dependencies
RUN dnf install -y \
    gcc gcc-c++ make diffutils \
    autoconf automake libtool pkg-config \
    cmake ninja-build \
    libnl3-devel \
    python3 \
    pciutils-devel \
    && dnf clean all

# nvml.h for libfabric's CUDA HMEM support (src/hmem_cuda.c includes it under
# HAVE_CUDA). This base image ships cuda-cudart-devel but not cuda-nvml-devel,
# and the only RPM source for that header is NVIDIA's own repo, whose repo id is
# not in Conforma's known_rpm_repositories list. So we vendor the header from a
# pinned submodule, like rdma-core/libfabric/perftest. Compile-time only: with
# --enable-cuda-dlopen libfabric never links libnvidia-ml, it dlopen()s
# libnvidia-ml.so.1 at runtime, and the header never reaches the runtime stage.
# NOTE: use gen/nvml/nvml.h (pristine upstream header), NOT pkg/nvml/nvml.h —
# the latter rewrites opaque handle typedefs (nvmlDevice_t etc.) into cgo
# wrapper structs, which would not match libnvidia-ml.so's real ABI.
COPY tools/go-nvml/gen/nvml/nvml.h /tmp/nvml.h
RUN cp /tmp/nvml.h /usr/local/cuda/include/nvml.h && rm /tmp/nvml.h

# --- Step 1: Build and install rdma-core from the pinned submodule ---
# Provides: libibverbs.so, libefa.so (EFA), libmlx5.so (IB/RoCE), librdmacm.so
# NOTE: Unlike Dockerfile.dev, we do NOT need -DENABLE_RESOLVE_NEIGH=0 here
# because libnl3-devel is available from RH repos (installed above).
COPY tools/rdma-core/ /tmp/rdma-core/
RUN cd /tmp/rdma-core && \
    cmake -GNinja -B build \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_INSTALL_LIBDIR=lib64 \
      -DNO_MAN_PAGES=1 \
      -DNO_PYVERBS=1 && \
    ninja -C build -j$(nproc) && \
    ninja -C build install && \
    ldconfig

# --- Step 2: Build and install libfabric from the pinned submodule ---
# Provides: libfabric.so.1 with EFA provider + CUDA HMEM support
# NOTE: --enable-cuda-dlopen is used because this RH CUDA base image has no
# libcuda.so/libnvidia-ml.so stubs. dlopen loads them at runtime via NVIDIA
# Container Toolkit injection. Dockerfile.dev links directly (--with-cuda)
# since the NVIDIA base image ships stubs. No CUDA stub symlinks needed here.
COPY tools/libfabric/ /tmp/libfabric/
RUN cd /tmp/libfabric && \
    ./autogen.sh && \
    ./configure --prefix=/usr --libdir=/usr/lib64 \
      --with-cuda=/usr/local/cuda \
      --enable-cuda-dlopen && \
    make -j$(nproc) && \
    make install && \
    ldconfig

# --- Step 3: Build fabtests (from libfabric source tree) ---
# Provides: fi_rdm_pingpong (EFA reachability), fi_rma_bw (EFA bandwidth)
RUN cd /tmp/libfabric/fabtests && \
    ./autogen.sh && \
    ./configure --prefix=/usr --libdir=/usr/lib64 \
      --with-cuda=/usr/local/cuda \
      --with-libfabric=/usr && \
    make -j$(nproc) && \
    make install DESTDIR=/opt/fabtests

# --- Step 4: Build perftest from the pinned submodule ---
# Provides: ib_write_bw, ibv_rc_pingpong (IB/RoCE bandwidth + reachability)
COPY tools/perftest/ /tmp/perftest/
RUN test -f /tmp/perftest/autogen.sh || \
    { echo "ERROR: tools/perftest/ is empty. Run: git submodule update --init tools/perftest"; exit 1; } && \
    cd /tmp/perftest && \
    ./autogen.sh && \
    ./configure --prefix=/usr --enable-cudart && \
    make -j$(nproc) && \
    make install DESTDIR=/opt/perftest

# Runtime stage — vanilla UBI9, all RDMA libs copied from builder
FROM registry.redhat.io/ubi9/ubi@sha256:48393e4261b2544f652c915b3e052256ddf66ee95cd04dc0362191f302c4e94a

USER root
WORKDIR /root

# Install runtime utilities (no system rdma-core — we bring our own from source)
RUN dnf install -y \
    wget procps-ng jq bc iputils ethtool net-tools \
    numactl kmod systemd-udev libpcap python3 hostname \
    iperf3 tcpdump pciutils libnl3 \
    && dnf clean all

# Copy all shared libraries (rdma-core + libfabric)
COPY --from=builder \
    /usr/lib64/libib* \
    /usr/lib64/librdmacm* \
    /usr/lib64/libefa* \
    /usr/lib64/libmlx* \
    /usr/lib64/libfabric* \
    /usr/lib64/
# Provider plugins directory (libefa-rdma*.so, libmlx5-rdma*.so, etc.)
COPY --from=builder /usr/lib64/libibverbs/ /usr/lib64/libibverbs/

# Copy RDMA & libfabric executables
COPY --from=builder \
    /usr/bin/ibv_* \
    /usr/bin/fi_info \
    /opt/fabtests/usr/bin/* \
    /opt/perftest/usr/bin/* \
    /usr/local/bin/

# Copy infiniband-diags (ibstat, ibnetdiscover, iblinkinfo, perfquery, etc.)
COPY --from=builder \
    /usr/sbin/ib* \
    /usr/sbin/perfquery \
    /usr/sbin/saquery \
    /usr/sbin/smpquery \
    /usr/sbin/smpdump \
    /usr/sbin/vendstat \
    /usr/sbin/sminfo \
    /usr/sbin/

# Copy libcudart from builder — needed by perftest and fabtests at runtime.
# The GPU driver library (libcuda.so.1) is mounted by the NVIDIA Container Toolkit.
COPY --from=builder /usr/local/cuda/lib64/libcudart.so.* /usr/local/lib/
RUN ln -s libcudart.so.13 /usr/local/lib/libcudart.so && \
    echo "/usr/local/lib" > /etc/ld.so.conf.d/cuda.conf && ldconfig

RUN mkdir -p /results

CMD ["/bin/bash"]

LABEL name="rhoai/odh-rhaii-validator-tools-rhel9" \
      com.redhat.component="odh-rhaii-validator-tools-rhel9" \
      summary="RHAII Validator Tools" \
      description="RDMA and network bandwidth testing tools (iperf3, perftest, fabtests) with CUDA support for preflight validation of xKS clusters before AI workload deployment. Supports IB/RoCEv2 (via perftest) and AWS EFA (via libfabric fabtests)." \
      maintainer="Red Hat LLM-D Team" \
      io.k8s.display-name="RHAII Validator Tools" \
      io.k8s.description="RDMA and network bandwidth testing tools (iperf3, perftest, fabtests) with CUDA support for preflight validation of xKS clusters before AI workload deployment. Supports IB/RoCEv2 (via perftest) and AWS EFA (via libfabric fabtests)."
